.wrangler/
dist/

# Secrets, never commit
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*

# Dev-only notes, never commit
NOTES.md

